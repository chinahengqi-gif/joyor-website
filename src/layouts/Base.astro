---
import { getTranslations, LANG, SITE_URL } from '../i18n/index.js'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CartDrawer from '../components/CartDrawer.astro'
import '../styles/global.css'

const t = getTranslations(LANG)

interface Props {
  title: string
  description?: string
  transparentHeader?: boolean
  bgColor?: string
}

const { title, description = '', transparentHeader = false, bgColor = '#ffffff' } = Astro.props
const currentPath = Astro.url.pathname
---

<html lang={LANG}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {t.site_name}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- IBM Plex Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

  <!-- hreflang -->
  <link rel="alternate" hreflang="en" href={`https://joyorscooter.us${currentPath}`} />
  <link rel="alternate" hreflang="de" href={`https://joyorscooter.de${currentPath}`} />
  <link rel="alternate" hreflang="fr" href={`https://joyorscooter.fr${currentPath}`} />
  <link rel="alternate" hreflang="it" href={`https://joyor.it${currentPath}`} />
  <link rel="alternate" hreflang="x-default" href={`https://joyorscooter.us${currentPath}`} />
</head>
<body class="min-h-screen flex flex-col text-gray-900 font-['IBM_Plex_Sans',sans-serif] font-normal antialiased" style={`background-color: ${bgColor}`}>
  <Header transparent={transparentHeader} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  <CartDrawer />
</body>
</html>
