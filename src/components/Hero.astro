---
import { getTranslations, LANG } from '../i18n/index.js'

interface Props {
  title?: string
  subtitle?: string
  media?: 'video' | 'image'
  videoSrc?: string
  imageSrc?: string
  overlayOpacity?: number
}

const {
  title = 'Engineered for\nUrban Freedom.',
  subtitle = 'Joyor — the leading electric scooter brand. Premium build quality, exceptional range, designed for modern city life.',
  media = 'video',
  videoSrc = '/banner.mp4',
  imageSrc = '/banner.webp',
  overlayOpacity = 0.4,
} = Astro.props
const t = getTranslations(LANG)
---

<section class="relative w-full h-screen overflow-hidden">
  <!-- Background Image (always present as poster / fallback) -->
  <img
    src={imageSrc}
    alt=""
    class:list={[
      'absolute inset-0 w-full h-full object-cover',
      media === 'video' ? 'hero-poster' : '',
    ]}
    id="hero-image"
  />

  <!-- Background Video -->
  {media === 'video' && (
    <video
      class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700"
      autoplay
      muted
      loop
      playsinline
      id="hero-video"
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
  )}

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black" style={`opacity: ${overlayOpacity}`}></div>

  <!-- Content -->
  <div class="relative z-10 h-full flex flex-col justify-end pb-16 lg:pb-20 px-6 lg:px-10 max-w-[1440px] mx-auto">
    <div class="max-w-2xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl text-white font-medium leading-[1.1] tracking-tight whitespace-pre-line">{title}</h1>
      <p class="mt-4 text-base lg:text-lg text-white/75 max-w-xl leading-relaxed">{subtitle}</p>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
      <div class="flex items-center gap-8 text-white">
        <div>
          <p class="text-[11px] uppercase tracking-[0.15em] text-white/50">{t.top_speed}</p>
          <p class="text-2xl lg:text-3xl mt-0.5">75 km/h</p>
        </div>
        <div class="w-px h-10 bg-white/20"></div>
        <div>
          <p class="text-[11px] uppercase tracking-[0.15em] text-white/50">{t.max_range}</p>
          <p class="text-2xl lg:text-3xl mt-0.5">120 km</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a href="/e-scooters/"
           class="px-7 py-3 bg-white text-gray-900 text-sm tracking-wide rounded-full hover:bg-gray-100 transition-colors">
          {t.home_explore_all_models}
        </a>
        <a href="https://joyorprime.com" target="_blank" rel="noopener"
           class="px-7 py-3 border border-white/40 text-white text-sm tracking-wide rounded-full hover:bg-white/10 transition-colors">
          {t.nav_store}
        </a>
      </div>
    </div>
  </div>

  <!-- Video Pause Button -->
  {media === 'video' && (
    <button
      id="hero-video-toggle"
      class="absolute right-6 lg:right-10 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full border border-white/30 flex items-center justify-center text-white/70 hover:text-white hover:border-white/60 transition-colors"
      aria-label="Pause video"
    >
      <svg class="w-4 h-4" id="icon-pause" fill="currentColor" viewBox="0 0 24 24">
        <rect x="6" y="4" width="4" height="16" />
        <rect x="14" y="4" width="4" height="16" />
      </svg>
      <svg class="w-4 h-4 hidden" id="icon-play" fill="currentColor" viewBox="0 0 24 24">
        <polygon points="5,3 19,12 5,21" />
      </svg>
    </button>
  )}
</section>

<script>
  // Video: fade in after loaded
  const video = document.getElementById('hero-video') as HTMLVideoElement | null
  if (video) {
    video.addEventListener('canplay', () => {
      video.style.opacity = '1'
    }, { once: true })

    // Pause / Play toggle
    const toggleBtn = document.getElementById('hero-video-toggle')
    const iconPause = document.getElementById('icon-pause')
    const iconPlay = document.getElementById('icon-play')

    toggleBtn?.addEventListener('click', () => {
      if (video.paused) {
        video.play()
        iconPause?.classList.remove('hidden')
        iconPlay?.classList.add('hidden')
      } else {
        video.pause()
        iconPause?.classList.add('hidden')
        iconPlay?.classList.remove('hidden')
      }
    })
  }
</script>
