---
import { getTranslations, LANG } from '../i18n/index.js'
import { getLegalLinks } from '../lib/legal'
const t = getTranslations(LANG)
const year = new Date().getFullYear()
const legalLinks = getLegalLinks(LANG)

const sites = [
  { lang: 'en', label: 'United States', flag: '/images/flag/US.png', url: 'https://joyorscooter.us' },
  { lang: 'de', label: 'Deutschland', flag: '/images/flag/DE.png', url: 'https://joyorscooter.de' },
  { lang: 'fr', label: 'France', flag: '/images/flag/FR.png', url: 'https://joyorscooter.fr' },
  { lang: 'it', label: 'Italia', flag: '/images/flag/IT.png', url: 'https://joyor.it' },
]
const currentSite = sites.find(s => s.lang === LANG) || sites[0]
---

<footer class="bg-black text-white/60">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-10 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
      <div>
        <img src="/logo_white.png" alt="Joyor" class="h-3.5 lg:h-4 mb-6 opacity-80 w-auto flex-shrink-0" />
        <p class="text-sm leading-relaxed text-white">
          {t.site_tagline}
        </p>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.15em] text-white mb-4">{t.nav_products}</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/e-scooters/" class="hover:text-white transition-colors">{t.nav_scooters}</a></li>
          <li><a href="/parts/" class="hover:text-white transition-colors">{t.footer_parts}</a></li>
          <li><a href="https://joyorprime.com" target="_blank" rel="noopener" class="hover:text-white transition-colors">{t.nav_store}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.15em] text-white mb-4">{t.nav_company}</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/about/" class="hover:text-white transition-colors">{t.footer_about}</a></li>
          <li><a href="/blog/" class="hover:text-white transition-colors">{t.nav_blog}</a></li>
        </ul>

        <h4 class="text-xs uppercase tracking-[0.15em] text-white mb-4 mt-8">{t.nav_service}</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/service/warranty/" class="hover:text-white transition-colors">{t.service_warranty}</a></li>
          <li><a href={legalLinks.shipping} class="hover:text-white transition-colors">{t.footer_versand}</a></li>
          <li><a href={legalLinks.returns} class="hover:text-white transition-colors">{t.footer_returns}</a></li>
          <li><a href="/service/contact/" class="hover:text-white transition-colors">{t.service_contact}</a></li>
          <li><a href="https://account.joyorprime.com/" target="_blank" rel="noopener" class="hover:text-white transition-colors">{t.service_order_tracking}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs uppercase tracking-[0.15em] text-white mb-4">{t.nav_legal}</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href={legalLinks.legalNotice} class="hover:text-white transition-colors">{t.footer_legal}</a></li>
          <li><a href={legalLinks.privacy} class="hover:text-white transition-colors">{t.footer_privacy}</a></li>
          <li><a href={legalLinks.terms} class="hover:text-white transition-colors">{t.footer_agb}</a></li>
          <li><a href="/cookies/" class="hover:text-white transition-colors">{t.footer_cookies}</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/30">
      <span>{t.footer_copyright.replace('{year}', String(year))}</span>

      <!-- Region Selector Trigger -->
      <button class="region-trigger flex items-center gap-2 text-white/50 hover:text-white transition-colors text-xs">
        <img src={currentSite.flag} alt={currentSite.label} class="h-3 w-auto" />
        {currentSite.label}
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </div>
  </div>
</footer>

<!-- Region Modal (shared, fullscreen) -->
<div id="region-modal" class="fixed inset-0 z-[100] opacity-0 pointer-events-none transition-opacity duration-300">
  <div id="region-modal-backdrop" class="absolute inset-0 bg-black/60"></div>
  <div class="relative h-full w-full flex items-center justify-center p-6">
    <div id="region-modal-card" class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl p-8 lg:p-12 transform scale-95 transition-transform duration-300">
      <button id="region-modal-close" aria-label="Close" class="absolute top-5 right-5 w-9 h-9 flex items-center justify-center rounded-full hover:bg-black/5 transition-colors text-black">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
      </button>
      <h2 class="text-2xl lg:text-3xl font-medium text-black tracking-tight mb-2">{t.region_choose_title}</h2>
      <p class="text-sm text-black/60 mb-8">{t.region_choose_text}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {sites.map(site => (
          <a href={site.url} class:list={[
            'flex items-center gap-4 p-4 rounded-2xl border transition-all',
            site.lang === LANG ? 'border-black bg-black/5' : 'border-black/10 hover:border-black hover:bg-black/5'
          ]}>
            <img src={site.flag} alt={site.label} class="h-5 w-auto flex-shrink-0" />
            <span class="flex-1 text-sm font-medium text-black">{site.label}</span>
            {site.lang === LANG && (
              <svg class="w-4 h-4 text-black flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5L20 7"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const regionModal = document.getElementById('region-modal')
  const regionCard = document.getElementById('region-modal-card')
  const regionBackdrop = document.getElementById('region-modal-backdrop')
  const regionClose = document.getElementById('region-modal-close')

  const openRegionModal = () => {
    regionModal?.classList.remove('opacity-0', 'pointer-events-none')
    regionModal?.classList.add('opacity-100', 'pointer-events-auto')
    regionCard?.classList.remove('scale-95')
    regionCard?.classList.add('scale-100')
    document.body.style.overflow = 'hidden'
  }
  const closeRegionModal = () => {
    regionModal?.classList.add('opacity-0', 'pointer-events-none')
    regionModal?.classList.remove('opacity-100', 'pointer-events-auto')
    regionCard?.classList.add('scale-95')
    regionCard?.classList.remove('scale-100')
    document.body.style.overflow = ''
  }

  document.querySelectorAll('.region-trigger').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault()
      e.stopPropagation()
      openRegionModal()
    })
  })

  regionBackdrop?.addEventListener('click', closeRegionModal)
  regionClose?.addEventListener('click', closeRegionModal)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeRegionModal()
  })
</script>
