---
import Base from '../../layouts/Base.astro'
import { getTranslations, LANG } from '../../i18n/index.js'
import { getLegalLinks } from '../../lib/legal'

const t = getTranslations(LANG)
const legalLinks = getLegalLinks(LANG)
---

<Base title={t.common_contact_us} description={t.service_contact_meta_description}>
  <div class="pt-28 pb-20">

    <!-- Breadcrumb -->
    <div class="max-w-3xl mx-auto px-6 lg:px-8 mb-6">
      <nav class="text-xs uppercase tracking-widest text-black/40">
        <a href="/service/" class="hover:text-black transition-colors">{t.nav_service}</a>
        <span class="mx-2">/</span>
        <span class="text-black">{t.service_contact}</span>
      </nav>
    </div>

    <!-- Header -->
    <section class="max-w-3xl mx-auto px-6 lg:px-8 mb-12">
      <h1 class="text-3xl lg:text-4xl font-medium tracking-tight mb-4 font-['IBM_Plex_Sans',sans-serif]">{t.common_contact_us}</h1>
      <p class="text-base text-black">{t.service_contact_intro}</p>
    </section>

    <!-- Contact Methods -->
    <section class="max-w-3xl mx-auto px-6 lg:px-8 mb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Email -->
        <a href="mailto:support@joyorprime.com" class="group block p-8 bg-white rounded-3xl transition-colors">
          <div class="w-12 h-12 bg-[#f5f5f7] rounded-2xl flex items-center justify-center mb-6 group-hover:bg-black group-hover:text-white transition-colors text-black/60">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h2 class="text-xl font-medium text-black mb-1">{t.common_email}</h2>
          <p class="text-sm text-black/50 mb-3">{t.contact_email_desc}</p>
          <p class="text-sm font-medium text-black">support@joyorprime.com</p>
        </a>

        <!-- WhatsApp -->
        <a href="https://wa.me/12029299733" target="_blank" rel="noopener" class="group block p-8 bg-white rounded-3xl transition-colors">
          <div class="w-12 h-12 bg-[#f5f5f7] rounded-2xl flex items-center justify-center mb-6 group-hover:bg-[#25D366] group-hover:text-white transition-colors text-black/60">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
          </div>
          <h2 class="text-xl font-medium text-black mb-1">WhatsApp</h2>
          <p class="text-sm text-black/50 mb-3">{t.contact_whatsapp_desc}</p>
          <p class="text-sm font-medium text-black">+1 (202) 929 9733</p>
        </a>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="max-w-3xl mx-auto px-6 lg:px-8 mb-16">
      <h2 class="text-xs uppercase tracking-[0.15em] text-black/50 font-medium mb-6">{t.service_common_topics}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/service/warranty/" class="flex items-center gap-4 p-5 bg-white rounded-2xl hover:bg-[#f5f5f7] transition-colors">
          <svg class="w-5 h-5 text-black/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
          <div>
            <p class="text-sm font-medium text-black">{t.service_warranty_claims}</p>
            <p class="text-xs text-black/50">{t.service_warranty_claims_desc}</p>
          </div>
        </a>
        <a href="https://account.joyorprime.com/" target="_blank" rel="noopener" class="flex items-center gap-4 p-5 bg-white rounded-2xl hover:bg-[#f5f5f7] transition-colors">
          <svg class="w-5 h-5 text-black/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
          <div>
            <p class="text-sm font-medium text-black">{t.service_order_tracking}</p>
            <p class="text-xs text-black/50">{t.service_link_tracking_desc}</p>
          </div>
        </a>
        <a href={legalLinks.shipping} class="flex items-center gap-4 p-5 bg-white rounded-2xl hover:bg-[#f5f5f7] transition-colors">
          <svg class="w-5 h-5 text-black/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
          <div>
            <p class="text-sm font-medium text-black">{t.service_shipping_info}</p>
            <p class="text-xs text-black/50">{t.service_shipping_info_desc}</p>
          </div>
        </a>
        <a href={legalLinks.returns} class="flex items-center gap-4 p-5 bg-white rounded-2xl hover:bg-[#f5f5f7] transition-colors">
          <svg class="w-5 h-5 text-black/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"/></svg>
          <div>
            <p class="text-sm font-medium text-black">{t.service_returns_refunds}</p>
            <p class="text-xs text-black/50">{t.service_returns_refunds_desc}</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Business Hours -->
    <section class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="p-8 bg-[#f5f5f7] rounded-3xl">
        <h2 class="text-xs uppercase tracking-[0.15em] text-black/50 font-medium mb-4">{t.common_response_time}</h2>
        <p class="text-black">{t.service_response_time_text}</p>
      </div>
    </section>

  </div>
</Base>
