---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'
import { getTranslations, LANG } from '../../i18n/index.js'

const t = getTranslations(LANG)

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content')
  const { LANG } = await import('../../i18n/index.js')
  const posts = await getCollection('blog', ({ id, data }) => !data.draft && id.startsWith(`${LANG}/`))
  return posts.map(post => ({
    params: { slug: post.id.replace(new RegExp(`^${LANG}/`), '') },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

// Related: same first tag, different post
const allPosts = (await getCollection('blog', ({ id, data }) => !data.draft && id.startsWith(`${LANG}/`)))
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const firstTag = post.data.tags[0]
const related = (firstTag
  ? allPosts.filter(p => p.data.tags.includes(firstTag))
  : allPosts
).slice(0, 3)

const stripLang = (id: string) => id.replace(new RegExp(`^${LANG}/`), '')
const fmtDate = (d: Date) => d.toLocaleDateString(LANG, { year: 'numeric', month: 'long', day: 'numeric' })
---

<Base title={post.data.title} description={post.data.description} bgColor="#ffffff">
  <article class="pt-28 pb-20">

    <!-- Breadcrumb -->
    <div class="max-w-3xl mx-auto px-6 lg:px-10 mb-6">
      <nav class="text-xs uppercase tracking-widest text-black/40">
        <a href="/blog/" class="hover:text-black transition-colors">{t.blog_title}</a>
        {post.data.tags[0] && (
          <>
            <span class="mx-2">/</span>
            <a href={`/blog/tag/${post.data.tags[0]}/`} class="hover:text-black transition-colors">{post.data.tags[0]}</a>
          </>
        )}
      </nav>
    </div>

    <!-- Header -->
    <header class="max-w-3xl mx-auto px-6 lg:px-10 mb-10">
      <h1 class="text-3xl md:text-5xl font-medium tracking-tight text-black leading-tight mb-6 font-['IBM_Plex_Sans',sans-serif]">{post.data.title}</h1>
      <p class="text-lg lg:text-xl text-black leading-relaxed mb-6">{post.data.description}</p>
      <div class="flex items-center gap-3 text-xs text-black/50">
        <span>{post.data.author}</span>
        <span>·</span>
        <span>{fmtDate(post.data.date)}</span>
        {post.data.updated && (
          <>
            <span>·</span>
            <span>{t.blog_updated || 'Updated'} {fmtDate(post.data.updated)}</span>
          </>
        )}
      </div>
    </header>

    <!-- Cover -->
    {post.data.cover && (
      <div class="max-w-5xl mx-auto px-6 lg:px-10 mb-12 lg:mb-16">
        <div class="aspect-[16/9] bg-[#f5f5f7] rounded-3xl overflow-hidden">
          <img src={post.data.cover.src} alt={post.data.coverAlt || post.data.title} class="w-full h-full object-cover" />
        </div>
      </div>
    )}

    <!-- Body -->
    <div class="max-w-3xl mx-auto px-6 lg:px-10">
      <div class="prose-blog">
        <Content />
      </div>

      <!-- Tags -->
      {post.data.tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-black/10 flex flex-wrap gap-2">
          {post.data.tags.map(tag => (
            <a href={`/blog/tag/${tag}/`} class="px-4 py-2 border border-black/20 text-xs font-semibold text-black rounded-full uppercase tracking-wider hover:bg-black hover:text-white transition-colors">{tag}</a>
          ))}
        </div>
      )}
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <section class="max-w-[1440px] mx-auto px-6 lg:px-10 mt-20 pt-16 border-t border-black/10">
        <h2 class="text-2xl lg:text-3xl font-medium tracking-tight text-black mb-8">{t.blog_related || 'Keep reading'}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map(p => (
            <a href={`/blog/${stripLang(p.id)}/`} class="group block bg-white rounded-2xl overflow-hidden border border-black/5 transition-colors">
              <div class="aspect-[4/3] bg-[#f5f5f7] overflow-hidden">
                {p.data.cover ? (
                  <img src={p.data.cover.src} alt={p.data.coverAlt || p.data.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-black/20 text-[10px] uppercase tracking-widest">{t.blog_image_placeholder}</div>
                )}
              </div>
              <div class="p-6">
                <h3 class="text-lg font-medium tracking-tight text-black mb-2 leading-snug group-hover:underline underline-offset-4">{p.data.title}</h3>
                <p class="text-xs text-black/50">{fmtDate(p.data.date)}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </article>
</Base>

<style is:global>
  .prose-blog {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #000;
  }
  .prose-blog > * + * { margin-top: 1.25em; }
  .prose-blog h2 {
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin-top: 2.5em;
    margin-bottom: 0.6em;
    color: #000;
  }
  .prose-blog h3 {
    font-size: 1.375rem;
    font-weight: 500;
    margin-top: 2em;
    margin-bottom: 0.5em;
    color: #000;
  }
  .prose-blog p { color: #000; }
  .prose-blog a {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose-blog a:hover { text-decoration-thickness: 2px; }
  .prose-blog ul, .prose-blog ol {
    padding-left: 1.5em;
    list-style-position: outside;
  }
  .prose-blog ul { list-style-type: disc; }
  .prose-blog ol { list-style-type: decimal; }
  .prose-blog li { margin-top: 0.4em; color: #000; }
  .prose-blog strong { font-weight: 600; color: #000; }
  .prose-blog blockquote {
    border-left: 3px solid #000;
    padding-left: 1.25em;
    font-style: italic;
    color: #000;
  }
  .prose-blog hr {
    border: none;
    border-top: 1px solid rgba(0,0,0,0.1);
    margin: 2.5em 0;
  }
  .prose-blog code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: #f5f5f7;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .prose-blog pre {
    background: #0b0b0d;
    color: #f5f5f7;
    padding: 1.25em;
    border-radius: 12px;
    overflow-x: auto;
  }
  .prose-blog pre code { background: transparent; padding: 0; color: inherit; }
  .prose-blog img {
    border-radius: 16px;
    width: 100%;
    height: auto;
  }
</style>
