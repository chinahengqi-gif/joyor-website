---
import { getTranslations, LANG } from '../i18n/index.js'
import LegalDocument from '../components/LegalDocument.astro'
import { legalContent } from '../lib/legal-content'

const t = getTranslations(LANG)
const content = legalContent.returns[LANG] || legalContent.returns.en
---

<LegalDocument
  title={t.widerrufsrecht_title}
  description={content.description}
  updatedLabel={content.updatedLabel}
  sections={content.sections}
/>
