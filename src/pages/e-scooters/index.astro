---
import Base from '../../layouts/Base.astro'
import { getTranslations, LANG } from '../../i18n/index.js'
import { getScooters } from '../../lib/shopify.js'

const t = getTranslations(LANG)

const allScooters = await getScooters()
const scooters = allScooters.filter((s: any) => !s.title.toLowerCase().includes('used'))

// Load local JSON for specs (for compare modal)
const comparisonSpecKeys = ['Motor', 'Speed', 'Battery', 'Range', 'Net Weight', 'Load', 'Tire', 'Brake', 'Charging', 'Front Shock Absorber', 'Rear Shock Absorber', 'Fold size', 'Unfold size']
const allJsonFiles = import.meta.glob('../../data/scooters/*.json', { eager: true })
const allJsonMap = new Map<string, any>()
for (const [path, mod] of Object.entries(allJsonFiles)) {
  const d = (mod as any).default || mod
  if (d.handle) allJsonMap.set(d.handle, d)
}
const allModelsData = scooters
  .map((s: any) => {
    const json = allJsonMap.get(s.handle)
    const shortTitle = s.title.replace(/\s+(Electric\s+Scooter|Scooter|E-Motorcycle).*$/i, '').trim()
    return {
      handle: s.handle,
      title: s.title,
      shortTitle,
      image: s.scooterpng || s.images?.[0]?.url || '',
      price: s.price?.amount || 0,
      specs: json?.specs || {},
    }
  })
  .filter((m: any) => Object.keys(m.specs).length > 2)
const defaultCompareHandles = ['joyor-s10s-z', 'joyor-t10-1000w-dual-motors-75km-endurance', 'joyor-y8s-abe-electric-scooter', 'joyor-c10']

// 从标题提取系列字母，按系列分组
function getSeries(title: string) {
  const match = title.match(/JOYOR\s+([A-Z])\d/i)
  return match ? match[1].toUpperCase() : 'Other'
}

const seriesOrder = ['T', 'S', 'Y', 'C', 'F']
const grouped = new Map<string, any[]>()

for (const s of seriesOrder) {
  const items = scooters.filter((sc: any) => getSeries(sc.title) === s)
  if (items.length) grouped.set(s, items)
}
// 剩余未匹配的
const matched = new Set(seriesOrder)
const other = scooters.filter((sc: any) => !matched.has(getSeries(sc.title)))
if (other.length) grouped.set('Other', other)
const seriesMetadata: Record<string, { desc: string; img: string }> = {
  S: { desc: t.series_desc_s, img: "/images/Sseries.jpg" },
  T: { desc: t.series_desc_t, img: "/images/Tseries.jpg" },
  Y: { desc: t.series_desc_y, img: "/images/Yseries.jpg" },
  C: { desc: t.series_desc_c, img: "/images/Cseries.jpg" },
  F: { desc: t.series_desc_f, img: "/images/Fseries.jpg" },
  Other: { desc: t.series_desc_other, img: "/images/Sseries.jpg" }
}
---

<Base title={t.e_scooters_title} description={t.e_scooters_meta_description} bgColor="#eeeff2">
  <div class="pt-28 pb-20">

    <!-- Mobile Title (not sticky) -->
    <div class="lg:hidden max-w-[1440px] mx-auto px-6 mb-4">
      <h1 class="text-4xl font-medium tracking-tight font-['IBM_Plex_Sans',sans-serif]">{t.e_scooters_title}</h1>
    </div>

    <!-- Sticky Action Bar -->
    <div id="filter-overlay" class="fixed inset-0 bg-black/10 z-[55] opacity-0 pointer-events-none transition-opacity duration-300"></div>
    <div class="sticky top-12 lg:static z-30 mb-8 lg:mb-12" id="action-bar">
      <div class="max-w-[1440px] mx-auto px-6 lg:px-10 py-3 flex flex-wrap lg:flex-nowrap items-center gap-3">
        <h1 class="hidden lg:block lg:w-auto text-4xl md:text-5xl font-medium tracking-tight font-['IBM_Plex_Sans',sans-serif] lg:mr-auto">{t.e_scooters_title}</h1>
        <div class="w-full lg:w-auto grid grid-cols-2 lg:flex gap-3">
        <button
          id="compare-all-btn"
          class="px-5 py-1.5 bg-transparent border border-gray-400 rounded-full transition-all hover:border-black font-medium text-sm text-[#1e1e1e] text-center"
        >
          {t.nav_compare}
        </button>

      <div class="relative" id="filter-container">
        <button
          id="filter-toggle"
          class="w-full flex items-center justify-center gap-2 px-5 py-1.5 bg-transparent border border-gray-400 rounded-full transition-all hover:border-black font-medium text-sm group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="group-hover:scale-110 transition-transform"><path d="M5 7C5 6.17157 5.67157 5.5 6.5 5.5C7.32843 5.5 8 6.17157 8 7C8 7.82843 7.32843 8.5 6.5 8.5C5.67157 8.5 5 7.82843 5 7ZM6.5 3.5C4.567 3.5 3 5.067 3 7C3 8.933 4.567 10.5 6.5 10.5C8.433 10.5 10 8.933 10 7C10 5.067 8.433 3.5 6.5 3.5ZM12 8H20V6H12V8ZM16 17C16 16.1716 16.6716 15.5 17.5 15.5C18.3284 15.5 19 16.1716 19 17C19 17.8284 18.3284 18.5 17.5 18.5C16.6716 18.5 16 17.8284 16 17ZM17.5 13.5C15.567 13.5 14 15.067 14 17C14 18.933 15.567 20.5 17.5 20.5C19.433 20.5 21 18.933 21 17C21 15.067 19.433 13.5 17.5 13.5ZM4 16V18H12V16H4Z"></path></svg>
          <span class="text-[#1e1e1e]">{t.filter}</span>
        </button>

        <!-- Filter Dropdown -->
        <div
          id="filter-panel"
          class="fixed right-3 lg:right-auto w-[calc(100vw-1.5rem)] md:w-[360px] bg-white rounded-2xl shadow-2xl z-[60] p-6 origin-top-right opacity-0 translate-y-2 pointer-events-none transition-all duration-300 ease-out"
        >
          <div class="space-y-6">
            <!-- Series Filter -->
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">{t.filter_series}</p>
              <div class="flex flex-wrap gap-2">
                {seriesOrder.map(s => (
                  <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="series" data-value={s}>{s} {t.series_suffix}</button>
                ))}
              </div>
            </div>

            <!-- Range Filter -->
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">{t.filter_range}</p>
              <div class="flex flex-wrap gap-2">
                <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="range" data-value="short">&lt; 30km</button>
                <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="range" data-value="mid">30-55km</button>
                <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="range" data-value="long">&gt; 55km</button>
              </div>
            </div>

            <!-- Power Filter -->
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">{t.filter_power}</p>
              <div class="flex flex-wrap gap-2">
                <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="power" data-value="low">250W</button>
                <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="power" data-value="mid">350W-500W</button>
                <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="power" data-value="high">500W+</button>
              </div>
            </div>

            <!-- Speed Filter -->
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">{t.filter_speed}</p>
              <div class="flex flex-wrap gap-2">
                <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="speed" data-value="standard">25km/h</button>
                <button class="filter-btn px-4 py-2 border border-black text-xs font-semibold text-gray-900 transition-all rounded-lg" data-type="speed" data-value="high">&gt; 25km/h</button>
              </div>
            </div>

            <button id="clear-filters" class="w-full py-3 border border-black rounded-lg text-xs font-bold uppercase tracking-widest text-gray-900 transition-all">{t.clear_all_filters}</button>
          </div>
        </div>
      </div>
      </div><!-- buttons wrapper -->
      </div>
    </div>

    <!-- Series Sections -->
    {[...grouped.entries()].map(([series, items]) => (
      <section id={`${series.toLowerCase()}-series`} class="series-section max-w-[1440px] mx-auto px-6 lg:px-10 mb-16 transition-all duration-500 scroll-mt-24">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Series Highlight Card -->
          <article class="series-highlight-card bg-white lg:bg-transparent rounded-2xl overflow-hidden sm:col-span-2 lg:col-span-2 flex flex-col">
            <div class="relative min-h-[240px] lg:min-h-[500px] lg:flex-1">
              <img
                src={seriesMetadata[series]?.img || seriesMetadata.Other.img}
                alt={`Joyor ${series} ${t.series_suffix}`}
                class="absolute inset-0 w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-br from-black/25 via-transparent to-transparent hidden lg:block"></div>
              <div class="relative z-10 text-white hidden lg:block p-8 lg:p-14">
                <h2 class="text-4xl font-semibold mb-3 uppercase tracking-tight">
                  {series === 'Other' ? t.other_models : `Joyor ${series} ${t.series_suffix}`}
                </h2>
                <p class="text-white text-lg leading-relaxed max-w-md opacity-90">
                  {seriesMetadata[series]?.desc || seriesMetadata.Other.desc}
                </p>
              </div>
            </div>
            <div class="lg:hidden px-5 py-4">
              <h2 class="text-xl font-semibold mb-1.5 uppercase tracking-tight text-black">
                {series === 'Other' ? t.other_models : `Joyor ${series} ${t.series_suffix}`}
              </h2>
              <p class="text-sm leading-relaxed text-black">
                {seriesMetadata[series]?.desc || seriesMetadata.Other.desc}
              </p>
            </div>
          </article>

          {items.map(scooter => {
            const rangeVal = parseInt(scooter.specs.range) || 0;
            const powerVal = parseInt(scooter.specs.motor) || 0;
            const speedVal = parseInt(scooter.specs.speed) || 0;
            
            let rangeCat = 'short';
            if (rangeVal > 55) rangeCat = 'long';
            else if (rangeVal >= 30) rangeCat = 'mid';

            let powerCat = 'low';
            if (powerVal > 500) powerCat = 'high';
            else if (powerVal >= 350) powerCat = 'mid';

            let speedCat = 'standard';
            if (speedVal > 25) speedCat = 'high';

            return (
              <article 
                class="scooter-card group bg-white rounded-2xl overflow-hidden flex flex-col border-2 border-transparent hover:border-black transition-all duration-300"
                data-series={series}
                data-range={rangeCat}
                data-power={powerCat}
                data-speed={speedCat}
              >

              <div class="p-5 pb-2 flex justify-between items-baseline gap-4">
                <h3 class="text-base font-medium leading-tight truncate">{scooter.title.replace('JOYOR ', '')}</h3>
                <p class="text-gray-900 font-semibold text-sm shrink-0">€{scooter.price.amount.toFixed(2)}</p>
              </div>

              {scooter.images[0] && (
                <div class="px-4 pt-2 pb-6 flex-1 flex flex-col items-center justify-center relative overflow-hidden group/img">
                  <img
                    src={scooter.images[0].url}
                    alt={scooter.images[0].alt || scooter.title}
                    class="main-image w-full h-64 object-contain group-hover:scale-[1.03] transition-transform duration-500"
                    loading="lazy"
                    data-images={JSON.stringify(scooter.images.map((img: any) => img.url))}
                    data-current="0"
                  />
                  
                  <!-- Image Navigation Arrows -->
                  {scooter.images.length > 1 && (
                    <div class="absolute right-4 bottom-6 flex flex-col border border-black opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      <button
                        class="nav-prev w-8 h-8 flex items-center justify-center bg-white hover:bg-black hover:text-white transition-all border-b border-black"
                        aria-label="Previous image"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
                      </button>
                      <button
                        class="nav-next w-8 h-8 flex items-center justify-center bg-white hover:bg-black hover:text-white transition-all"
                        aria-label="Next image"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                      </button>
                    </div>
                  )}
                </div>
              )}

              <div class="border-t border-gray-100 px-5 py-5">
                <div class="grid grid-cols-3 gap-3 text-center">
                  <div>
                    <p class="text-[10px] uppercase tracking-[0.12em] text-gray-400 font-medium">{t.filter_range}</p>
                    <p class="mt-1 text-base font-semibold text-gray-900">{scooter.specs.range || '—'}</p>
                  </div>
                  <div class="border-x border-gray-100">
                    <p class="text-[10px] uppercase tracking-[0.12em] text-gray-400 font-medium">{t.filter_power}</p>
                    <p class="mt-1 text-base font-semibold text-gray-900">{scooter.specs.motor || '—'}</p>
                  </div>
                  <div>
                    <p class="text-[10px] uppercase tracking-[0.12em] text-gray-400 font-medium">{t.filter_speed}</p>
                    <p class="mt-1 text-base font-semibold text-gray-900">{scooter.specs.speed || '—'}</p>
                  </div>
                </div>
              </div>

              <div class="px-5 pb-5 grid grid-cols-2 gap-3">
                <a href={`/e-scooters/${scooter.handle}/`}
                   class="block text-center py-2 bg-black text-white text-[13px] font-medium tracking-wide rounded-[4px] hover:bg-gray-800 transition-colors duration-200">
                  {t.learn_more}
                </a>
                <a href={`/e-scooters/${scooter.handle}/#features`}
                   class="block text-center py-2 border border-black text-black text-[13px] font-medium tracking-wide rounded-[4px] hover:bg-black/5 transition-colors duration-200">
                  {t.features}
                </a>
              </div>

              </article>
            )
          })}
        </div>
      </section>
    ))}
  </div>

  <style>
    @reference "../../styles/global.css";
    .filter-btn {
      background-color: transparent;
    }
    .filter-btn:hover:not(.active) {
      background-color: #f9fafb; /* bg-gray-50 */
    }
    .filter-btn.active {
      background-color: black !important;
      color: white !important;
    }
    #clear-filters:hover {
      background-color: black;
      color: white;
    }
  </style>

  <script>
    function setupFilters() {
      const filterToggle = document.getElementById('filter-toggle');
      const filterPanel = document.getElementById('filter-panel');
      const filterOverlay = document.getElementById('filter-overlay');
      const filterBtns = document.querySelectorAll('.filter-btn');
      const clearFilters = document.getElementById('clear-filters');
      const cards = document.querySelectorAll('.scooter-card');
      const sections = document.querySelectorAll('.series-section');

      let activeFilters: Record<string, string[]> = {
        series: [],
        range: [],
        power: [],
        speed: []
      };

      // Portal panel + overlay to body to escape sticky stacking context
      if (filterPanel && filterPanel.parentElement !== document.body) {
        document.body.appendChild(filterPanel);
      }
      if (filterOverlay && filterOverlay.parentElement !== document.body) {
        document.body.appendChild(filterOverlay);
      }

      const positionPanel = () => {
        if (!filterPanel || !filterToggle) return;
        const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
        if (isDesktop) {
          const rect = filterToggle.getBoundingClientRect();
          filterPanel.style.top = `${rect.bottom + 16}px`;
          filterPanel.style.right = `${window.innerWidth - rect.right}px`;
          filterPanel.style.left = 'auto';
        } else {
          filterPanel.style.top = `${56 + 56}px`;
          filterPanel.style.right = '12px';
          filterPanel.style.left = 'auto';
        }
      };

      const togglePanel = (open: boolean) => {
        if (open) {
          positionPanel();
          filterPanel?.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
          filterPanel?.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
          filterOverlay?.classList.add('opacity-100', 'pointer-events-auto');
          filterOverlay?.classList.remove('opacity-0', 'pointer-events-none');
        } else {
          filterPanel?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          filterPanel?.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
          filterOverlay?.classList.remove('opacity-100', 'pointer-events-auto');
          filterOverlay?.classList.add('opacity-0', 'pointer-events-none');
        }
      };

      filterToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = filterPanel?.classList.contains('opacity-100');
        togglePanel(!isOpen);
      });

      filterOverlay?.addEventListener('click', () => togglePanel(false));

      document.addEventListener('click', (e) => {
        if (filterPanel && !filterPanel.contains(e.target as Node) && e.target !== filterToggle) {
          togglePanel(false);
        }
      });

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const b = btn as HTMLElement;
          const type = b.dataset.type!;
          const value = b.dataset.value!;
          
          if (activeFilters[type].includes(value)) {
            activeFilters[type] = activeFilters[type].filter(v => v !== value);
            b.classList.remove('active');
          } else {
            activeFilters[type].push(value);
            b.classList.add('active');
          }
          
          applyFilters();
        });
      });

      clearFilters?.addEventListener('click', () => {
        activeFilters = { series: [], range: [], power: [], speed: [] };
        filterBtns.forEach(btn => {
          btn.classList.remove('active');
        });
        applyFilters();
      });

      function applyFilters() {
        const isFilterActive = activeFilters.series.length > 0 || 
                               activeFilters.range.length > 0 || 
                               activeFilters.power.length > 0 ||
                               activeFilters.speed.length > 0;

        cards.forEach(card => {
          const c = card as HTMLElement;
          const matchesSeries = activeFilters.series.length === 0 || activeFilters.series.includes(c.dataset.series!);
          const matchesRange = activeFilters.range.length === 0 || activeFilters.range.includes(c.dataset.range!);
          const matchesPower = activeFilters.power.length === 0 || activeFilters.power.includes(c.dataset.power!);
          const matchesSpeed = activeFilters.speed.length === 0 || activeFilters.speed.includes(c.dataset.speed!);

          if (matchesSeries && matchesRange && matchesPower && matchesSpeed) {
            c.classList.remove('hidden');
          } else {
            c.classList.add('hidden');
          }
        });

        sections.forEach(section => {
          const s = section as HTMLElement;
          const hasVisibleCards = s.querySelectorAll('.scooter-card:not(.hidden)').length > 0;
          const highlightCard = s.querySelector('.series-highlight-card') as HTMLElement;
          
          if (hasVisibleCards) {
            s.classList.remove('hidden');
            if (isFilterActive) {
               highlightCard?.classList.add('hidden');
            } else {
               highlightCard?.classList.remove('hidden');
            }
          } else {
            s.classList.add('hidden');
          }
        });
      }
    }

    function setupCardNavigation() {
      const cards = document.querySelectorAll('.scooter-card');
      cards.forEach(card => {
        const mainImage = card.querySelector('.main-image') as HTMLImageElement | null;
        if (!mainImage) return;

        const imagesString = mainImage.dataset.images;
        if (!imagesString) return;
        
        const images = JSON.parse(imagesString);
        if (images.length <= 1) return;

        const btnPrev = card.querySelector('.nav-prev') as HTMLButtonElement | null;
        const btnNext = card.querySelector('.nav-next') as HTMLButtonElement | null;

        let currentIndex = 0;

        const updateImage = (index: number) => {
          currentIndex = (index + images.length) % images.length;
          
          // 给用户即时的反馈：降低透明度表示正在加载
          mainImage.style.opacity = '0.3';
          
          // 预加载下一张图片
          const nextSrc = images[currentIndex];
          const loader = new Image();
          
          loader.onload = () => {
            // 只有在图片完全加载后才切换 src 并恢复透明度
            mainImage.src = nextSrc;
            mainImage.style.opacity = '1';
          };
          
          loader.src = nextSrc;
        };

        btnPrev?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          updateImage(currentIndex - 1);
        });

        btnNext?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          updateImage(currentIndex + 1);
        });
      });
    }

    function setupStickyBar() {
      const bar = document.getElementById('action-bar');
      if (!bar) return;
      const check = () => {
        const isMobile = window.matchMedia('(max-width: 1023px)').matches;
        if (!isMobile) {
          bar.style.backgroundColor = '';
          bar.style.backdropFilter = '';
          bar.style.boxShadow = '';
          return;
        }
        const stuck = bar.getBoundingClientRect().top <= 49;
        if (stuck) {
          bar.style.backgroundColor = 'rgba(255,255,255,0.95)';
          bar.style.backdropFilter = 'blur(20px)';
          bar.style.boxShadow = '0 1px 3px rgba(0,0,0,0.06)';
        } else {
          bar.style.backgroundColor = '';
          bar.style.backdropFilter = '';
          bar.style.boxShadow = '';
        }
      };
      window.addEventListener('scroll', check, { passive: true });
      window.addEventListener('resize', check);
      check();
    }

    function init() {
      setupFilters();
      setupCardNavigation();
      setupStickyBar();
    }

    // Initial load
    init();

    // Re-run on View Transitions navigation
    document.addEventListener('astro:after-swap', init);
  </script>

  <!-- ===== FULLSCREEN COMPARE MODAL ===== -->
  <div id="compare-modal" class="fixed inset-0 z-[200] bg-white compare-modal-hidden" style="overflow-y: auto">
    <div class="sticky top-0 bg-white/95 backdrop-blur-xl z-10 border-b border-black/5">
      <div class="max-w-[1440px] mx-auto px-6 lg:px-10 py-4 flex items-center justify-between">
        <h2 class="text-lg font-medium text-black">{t.compare_models}</h2>
        <button id="compare-modal-close" class="p-2 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors group" aria-label="Close">
          <svg class="w-5 h-5 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <div class="max-w-[1440px] mx-auto px-6 lg:px-10 py-8 lg:py-12">
      <div id="compare-modal-scroll" class="overflow-x-auto compare-scroll-hide">
        <div id="compare-modal-inner">
          <div id="compare-selectors"></div>
          <div id="compare-modal-content"></div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ allModelsData, defaultCompareHandles, comparisonSpecKeys }}>
    const modal = document.getElementById('compare-modal')
    const openBtn = document.getElementById('compare-all-btn')
    const closeBtn = document.getElementById('compare-modal-close')
    const selectorsEl = document.getElementById('compare-selectors')
    const contentEl = document.getElementById('compare-modal-content')
    const innerEl = document.getElementById('compare-modal-inner')

    let selectedHandles = [...defaultCompareHandles]

    function getModel(h) {
      return allModelsData.find(m => m.handle === h)
    }

    const cols = () => selectedHandles.map(() => '1fr').join(' ')

    function renderSelectors() {
      if (!selectorsEl) return
      const models = selectedHandles.map(h => getModel(h))
      selectorsEl.innerHTML = `
        <div class="grid gap-4 lg:gap-6 mb-10 lg:mb-16" style="grid-template-columns: ${cols()}">
          ${models.map((m, i) => `
            <div class="text-center">
              <div class="h-24 lg:h-36 flex items-end justify-center mb-3">
                ${m?.image ? `<img src="${m.image}" alt="${m.shortTitle}" class="max-h-full max-w-full object-contain" />` : '<div class="w-20 h-20 bg-gray-100 rounded-lg"></div>'}
              </div>
              <select data-slot="${i}" class="compare-select w-full appearance-none bg-transparent border border-black rounded-lg pl-2 pr-7 py-2.5 text-xs lg:text-sm font-medium text-black text-center cursor-pointer hover:bg-gray-50 transition-colors focus:outline-none truncate"
                style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%2212%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%23000%22 stroke-width=%222%22%3E%3Cpath d=%22m6 9 6 6 6-6%22/%3E%3C/svg%3E'); background-repeat: no-repeat; background-position: right 6px center;">
                ${allModelsData.map(am => `<option value="${am.handle}" ${am.handle === selectedHandles[i] ? 'selected' : ''}>${am.shortTitle}</option>`).join('')}
              </select>
            </div>
          `).join('')}
        </div>
      `
      selectorsEl.querySelectorAll('.compare-select').forEach(sel => {
        sel.addEventListener('change', (e) => {
          const t = e.target
          const slot = parseInt(t.dataset.slot)
          selectedHandles[slot] = t.value
          renderSelectors()
          renderTable()
        })
      })
    }

    function renderTable() {
      if (!contentEl) return
      const models = selectedHandles.map(h => getModel(h)).filter(Boolean)
      const activeKeys = comparisonSpecKeys.filter(key => models.some(m => m.specs[key]))
      const colW = Math.max(models.length * 160, 600)

      if (innerEl) innerEl.style.minWidth = window.innerWidth >= 1024 ? '' : `${colW}px`
      contentEl.innerHTML = activeKeys.map(key => `
        <div class="border-t border-black/8 pt-4 pb-5">
          <p class="text-[10px] font-medium tracking-[0.2em] uppercase text-black/35 pl-4 lg:pl-0 mb-2">${key}</p>
          <div class="grid" style="grid-template-columns: ${cols()}">
            ${models.map(m => `
              <p class="text-sm lg:text-base text-black text-center px-4">${m.specs[key] || '—'}</p>
            `).join('')}
          </div>
        </div>
      `).join('')
    }

    openBtn?.addEventListener('click', () => {
      selectedHandles = [...defaultCompareHandles]
      modal?.classList.remove('compare-modal-hidden')
      document.body.style.overflow = 'hidden'
      renderSelectors()
      renderTable()
    })

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('compare-modal-hidden')
      document.body.style.overflow = ''
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('compare-modal-hidden')) {
        modal?.classList.add('compare-modal-hidden')
        document.body.style.overflow = ''
      }
    })
  </script>

  <style>
    @reference "../../styles/global.css";
    #compare-modal {
      transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .compare-modal-hidden {
      opacity: 0;
      transform: translateY(30px);
      pointer-events: none;
    }
    .compare-scroll-hide {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .compare-scroll-hide::-webkit-scrollbar {
      display: none;
    }
  </style>
</Base>
