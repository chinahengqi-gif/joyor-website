---
import Base from '../../../layouts/Base.astro'
import { getTranslations, LANG } from '../../../i18n/index.js'
import { getLegalLinks } from '../../../lib/legal'
import { getCollectionProducts } from '../../../lib/shopify.js'
import { slugify } from '../../../lib/utils.js'

const t = getTranslations(LANG)
const legalLinks = getLegalLinks(LANG)

export async function getStaticPaths() {
  const { getCollectionProducts } = await import('../../../lib/shopify.js')
  const products = await getCollectionProducts()
  return products.map(p => ({
    params: { handle: p.handle },
    props: { product: p },
  }))
}

const { product } = Astro.props
const allProducts = await getCollectionProducts()

// 同分类推荐产品（排除自身）
const related = allProducts
  .filter(p => p.category === product.category && p.handle !== product.handle)
  .slice(0, 4)

const mainImage = product.images[0]
const hasMultipleImages = product.images.length > 1
---

<Base title={product.title} description={product.description}>
  <!-- Product Layout: two columns with continuous vertical divider -->
  <div class="max-w-[1440px] mx-auto px-6 lg:px-10 pt-12 lg:pt-14">
    <div class="grid grid-cols-1 lg:grid-cols-2">

      <!-- Left Column: Breadcrumb + Images + Details -->
      <div class="lg:border-r lg:border-gray-200 pt-6 lg:pt-10 pb-4 lg:pb-10 lg:pr-12">
        <!-- Main Image -->
        <div id="img-container" class="bg-[#f5f5f5] rounded-2xl overflow-hidden aspect-square relative group cursor-zoom-in">
          <div id="img-track" class="flex w-full h-full" style={hasMultipleImages ? `width: ${product.images.length * 100}%` : ''}>
            {hasMultipleImages ? (
              product.images.map((img, i) => (
                <div class="flex-shrink-0 w-full h-full flex items-center justify-center" style={`width: ${100 / product.images.length}%`}>
                  <img
                    src={img.url}
                    alt={img.alt || product.title}
                    class="w-full h-full object-contain"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ))
            ) : (
              <div class="flex-shrink-0 w-full h-full flex items-center justify-center">
                <img
                  id="main-product-image"
                  src={mainImage?.url || ''}
                  alt={mainImage?.alt || product.title}
                  class="w-full h-full object-contain"
                />
              </div>
            )}
          </div>

          {hasMultipleImages && (
            <div class="absolute inset-y-0 left-0 right-0 flex items-center justify-between px-3 opacity-0 group-hover:opacity-100 transition-opacity z-10">
              <button id="img-prev" class="w-9 h-9 rounded bg-white border border-gray-900 flex items-center justify-center hover:bg-gray-50 transition-colors" aria-label={t.parts_previous_image}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="m15 19-7-7 7-7"/></svg>
              </button>
              <button id="img-next" class="w-9 h-9 rounded bg-white border border-gray-900 flex items-center justify-center hover:bg-gray-50 transition-colors" aria-label={t.parts_next_image}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="m9 5 7 7-7 7"/></svg>
              </button>
            </div>
          )}
        </div>

        <!-- Thumbnails -->
        {hasMultipleImages && (
          <div id="thumb-strip" class="flex gap-2 mt-3 overflow-x-auto thumb-scroll-hide">
            {product.images.map((img, i) => (
              <button
                class:list={[
                  'thumb-btn flex-shrink-0 w-16 h-16 lg:w-20 lg:h-20 rounded-lg overflow-hidden border-[1.5px] transition-all',
                  i === 0 ? 'border-gray-900' : 'border-gray-200 hover:border-gray-400',
                ]}
                data-index={i}
                data-url={img.url}
              >
                <img src={`${img.url}${img.url.includes('?') ? '&' : '?'}width=160&height=160`} alt={img.alt || `Image ${i + 1}`} class="w-full h-full object-contain" loading="lazy" />
              </button>
            ))}
          </div>
        )}

      </div>

      <!-- Right Column: Info -->
      <div class="flex flex-col pt-2 lg:pt-10 pb-10 lg:pl-12">
        <!-- Title -->
        <h1 class="text-2xl lg:text-3xl font-medium tracking-tight leading-snug">{product.title}</h1>

        <!-- Price + Category/Models -->
        <div class="mt-6 pb-6 border-b border-gray-300 flex items-center justify-between gap-4">
          <div>
            <span class="text-3xl font-medium">€{product.price.amount.toFixed(2)}</span>
          </div>
          <div class="flex flex-wrap items-center justify-end gap-x-2 gap-y-1 text-sm">
            {product.category && (
              <a href={`/parts/${slugify(product.category)}/`} class="underline hover:text-black transition-colors">{product.category}</a>
            )}
            {product.compatible.map(model => (
              <a href={`/models/${slugify(model)}/`} class="underline hover:text-black transition-colors">{model}</a>
            ))}
            <a href="/parts/" class="underline hover:text-black transition-colors">{t.parts_all}</a>
          </div>
        </div>

        <!-- Variants (if more than Default Title) -->
        {product.variants.length > 1 && (
          <div class="mt-6 pb-6 border-b border-gray-300">
            <p class="text-xs uppercase tracking-[0.12em] text-gray-500 font-medium mb-3">{t.parts_options}</p>
            <div class="flex flex-wrap gap-2">
              {product.variants.map((v, i) => (
                <button
                  class:list={[
                    'variant-btn px-4 py-2 text-sm border rounded-lg transition-all',
                    i === 0 ? 'border-gray-900 bg-gray-900 text-white' : 'border-gray-300 hover:border-gray-900',
                    !v.available && 'opacity-40 cursor-not-allowed',
                  ]}
                  data-price={v.price}
                  disabled={!v.available}
                >
                  {v.title}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Availability -->
        <div class="mt-6 flex items-center gap-2">
          {product.variants[0]?.available ? (
            <>
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              <span class="text-sm text-gray-700">{t.parts_dispatch_time}</span>
            </>
          ) : (
            <>
              <span class="w-2 h-2 rounded-full bg-red-400"></span>
              <span class="text-sm text-gray-700">{t.parts_out_of_stock}</span>
            </>
          )}
        </div>

        <!-- Quantity + Add to Cart -->
        <div class="mt-6 flex gap-3 items-stretch">
          <div class="flex items-center border border-gray-900 rounded-lg overflow-hidden">
            <button id="qty-decrease" class="w-10 h-full flex items-center justify-center text-gray-900 hover:bg-gray-100 transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg>
            </button>
            <span id="qty-value" class="w-10 text-center text-sm font-medium text-gray-900 select-none">1</span>
            <button id="qty-increase" class="w-10 h-full flex items-center justify-center text-gray-900 hover:bg-gray-100 transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </div>
          <button
            id="add-to-cart-btn"
            class="flex-1 py-3.5 bg-black text-white text-sm font-medium tracking-wide rounded-lg hover:bg-gray-800 transition-colors flex items-center justify-center gap-2"
            data-handle={product.handle}
            data-title={product.title}
            data-price={product.price.amount}
            data-image={mainImage?.url || ''}
            data-variant-id={product.variantId || ''}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0z"/></svg>
            {t.add_to_cart}
          </button>
        </div>

        <!-- Payment Icons -->
        <div class="mt-4 flex items-center justify-center gap-2">
          {[1,2,3,4,5,6].map(i => (
            <img src={`/images/payicon/${i}.svg`} alt="" class="h-5" />
          ))}
        </div>

        <!-- Shipping Info -->
        <div class="mt-6 bg-[#f5f5f5] rounded-lg">
          <button id="shipping-info-btn" class="w-full flex items-center justify-between px-5 py-4 text-left hover:bg-[#efefef] transition-colors rounded-lg">
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19.5 17.5a2.5 2.5 0 1 1-5 0a2.5 2.5 0 0 1 5 0Zm-10 0a2.5 2.5 0 1 1-5 0a2.5 2.5 0 0 1 5 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M14.5 17.5h-5m10 0h.763c.22 0 .33 0 .422-.012a1.5 1.5 0 0 0 1.303-1.302c.012-.093.012-.203.012-.423V13a6.5 6.5 0 0 0-6.5-6.5m-.5 9V7c0-1.414 0-2.121-.44-2.56C14.122 4 13.415 4 12 4H5c-1.414 0-2.121 0-2.56.44C2 4.878 2 5.585 2 7v8c0 .935 0 1.402.201 1.75a1.5 1.5 0 0 0 .549.549c.348.201.815.201 1.75.201"/></g></svg>
              <div>
                <p class="text-sm font-medium text-gray-900">{t.parts_free_shipping}</p>
                <p class="text-xs text-gray-900 mt-0.5 underline">{t.parts_shipping_return_details}</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          </button>
        </div>

        <!-- Contact Assistance -->
        <div class="mt-6 bg-[#f5f5f5] rounded-lg px-5 py-5">
          <p class="text-sm font-medium">{t.parts_assistance_title}</p>
          <p class="text-sm mt-1">{t.parts_assistance_text}</p>
          <div class="flex gap-4 mt-4">
            <a href="https://wa.me/12029299733" target="_blank" rel="noopener" class="flex flex-col items-center gap-2 flex-1 bg-white rounded-lg py-3 hover:bg-gray-50 transition-colors">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" fill="#25D366"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z" stroke="#25D366" stroke-width="1.5" fill="none"/></svg>
              <span class="text-xs font-medium underline">{t.common_whatsapp}</span>
            </a>
            <a href="mailto:support@joyorprime.com" class="flex flex-col items-center gap-2 flex-1 bg-white rounded-lg py-3 hover:bg-gray-50 transition-colors">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="text-xs font-medium underline">{t.common_email}</span>
            </a>
          </div>
        </div>

        <!-- Description -->
        {product.descriptionHtml && (
          <div class="mt-8 pt-8 border-t border-gray-300">
            <h2 class="text-xs uppercase tracking-[0.15em] text-gray-500 font-medium mb-4">{t.parts_description}</h2>
            <div class="product-desc-wrapper relative overflow-hidden transition-[max-height] duration-300 ease-in-out" style="max-height: 300px;" id="desc-wrapper">
              <div class="prose prose-sm max-w-none text-gray-900 leading-relaxed product-description overflow-hidden"
                   set:html={product.descriptionHtml} />
              <div id="desc-fade" class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>
            </div>
            <button id="desc-toggle" class="mt-4 px-5 py-1.5 text-sm font-medium border border-gray-300 rounded-full text-gray-700 hover:border-gray-900 hover:text-gray-900 transition-colors">{t.parts_read_more}</button>
          </div>
        )}

      </div>
    </div>
  </div>

  <!-- Full-width bottom divider -->
  <div class="border-t border-gray-300"></div>

  <!-- Related Products -->
  {related.length > 0 && (
    <section class="max-w-[1440px] mx-auto px-6 lg:px-10 pb-20">
      <div class="pt-12">
        <h2 class="text-2xl font-medium tracking-tight mb-8">{t.parts_related}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {related.map(p => (
            <a href={`/parts/product/${p.handle}/`} class="group rounded-xl overflow-hidden border border-gray-200 hover:border-gray-300 transition-colors">
              <div class="aspect-square bg-[#f5f5f5] flex items-center justify-center">
                {p.images[0] && (
                  <img src={p.images[0].url} alt={p.images[0].alt || p.title}
                       class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                )}
              </div>
              <div class="p-4">
                <p class="text-sm text-gray-900 font-medium line-clamp-2 leading-snug">{p.title}</p>
                <p class="mt-1.5 text-sm text-gray-500">€{p.price.amount.toFixed(2)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Image Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[300] hidden">
    <div id="lightbox-overlay" class="absolute inset-0 bg-black/90 opacity-0 transition-opacity duration-300 cursor-pointer"></div>
    <button id="lightbox-close" class="absolute top-4 right-4 z-10 w-10 h-10 flex items-center justify-center text-white/80 hover:text-white transition-colors" aria-label="Close">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/></svg>
    </button>
    <!-- Centered content wrapper -->
    <div class="absolute inset-0 flex flex-col items-center justify-center p-6 lg:p-16 pointer-events-none">
      <div id="lightbox-content" class="relative flex items-center justify-center w-full flex-1 min-h-0 opacity-0 scale-95 transition-all duration-300 ease-out">
        {/* Desktop: prev/next on sides */}
        {hasMultipleImages && (
          <>
            <button id="lightbox-prev" class="hidden lg:flex absolute left-0 z-10 w-11 h-11 items-center justify-center text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full transition-colors pointer-events-auto" aria-label="Previous">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="m15 19-7-7 7-7"/></svg>
            </button>
            <button id="lightbox-next" class="hidden lg:flex absolute right-0 z-10 w-11 h-11 items-center justify-center text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full transition-colors pointer-events-auto" aria-label="Next">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="m9 5 7 7-7 7"/></svg>
            </button>
          </>
        )}
        <img id="lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain pointer-events-auto select-none transition-opacity duration-200" />
      </div>
      {/* Mobile: prev/next + counter below image */}
      {hasMultipleImages && (
        <div class="flex items-center justify-center gap-6 mt-5 pointer-events-auto flex-shrink-0">
          <button id="lightbox-prev-m" class="lg:hidden w-11 h-11 flex items-center justify-center text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full transition-colors" aria-label="Previous">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="m15 19-7-7 7-7"/></svg>
          </button>
          <span id="lightbox-counter" class="text-white/70 text-sm font-medium tabular-nums"></span>
          <button id="lightbox-next-m" class="lg:hidden w-11 h-11 flex items-center justify-center text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full transition-colors" aria-label="Next">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="m9 5 7 7-7 7"/></svg>
          </button>
        </div>
      )}
    </div>
  </div>

  <!-- Shipping Modal (outside content flow) -->
  <div id="shipping-modal" class="fixed inset-0 z-[200] hidden">
    <div id="shipping-modal-overlay" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300 ease-out cursor-pointer"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4 lg:p-8 pointer-events-none">
      <div id="shipping-modal-panel" class="relative bg-white rounded-2xl w-full max-w-[620px] max-h-[70vh] lg:max-h-[85vh] flex flex-col opacity-0 scale-95 translate-y-4 transition-all duration-300 ease-out pointer-events-auto">
        <!-- Header -->
        <div class="flex items-center justify-between px-8 py-6 border-b border-gray-200 flex-shrink-0">
          <h2 class="text-xl font-medium tracking-tight">{t.policy_information}</h2>
          <button id="shipping-modal-close" class="p-2 -mr-2 bg-gray-100 hover:bg-gray-200 rounded-full transition-colors group">
            <svg class="w-5 h-5 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- Content -->
        <div class="overflow-y-auto flex-1 px-8 py-6">
          <!-- Shipping Section -->
          <div class="mb-6">
            <h3 class="text-base font-medium text-gray-900 mb-3">{t.policy_shipping_parts}</h3>
            <div class="space-y-2 text-[15px] text-gray-900 leading-relaxed">
              <p>{t.policy_shipping_dispatch}</p>
              <p>{t.policy_shipping_china}</p>
              <p>{t.policy_shipping_eu}</p>
              <p>{t.policy_shipping_tracking}</p>
              <p>{t.policy_shipping_free}</p>
            </div>
          </div>

          <div class="border-t border-gray-300"></div>

          <!-- Returns Section -->
          <div class="mt-6 mb-6">
            <h3 class="text-base font-medium text-gray-900 mb-3">{t.policy_returns_title}</h3>
            <div class="space-y-2 text-[15px] text-gray-900 leading-relaxed">
              <p>{t.policy_returns_quality}</p>
              <p>{t.policy_returns_wrong}</p>
              <p>{t.policy_returns_delayed}</p>
              <p>{t.policy_returns_cancelled}</p>
              <p>{t.policy_returns_accessories}</p>
            </div>
          </div>

          <div class="border-t border-gray-300"></div>

          <div class="mt-6 text-[15px]">
            <a href={legalLinks.shipping} class="underline hover:text-black transition-colors">{t.policy_full_details}</a>
            <span class="mx-2 text-gray-300">·</span>
            <a href={legalLinks.returns} class="underline hover:text-black transition-colors">{t.policy_withdrawal}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .product-description :global(p) {
    margin-bottom: 0.75rem;
  }
  .product-description :global(strong),
  .product-description :global(b) {
    font-weight: 500;
    color: #111;
  }
  .product-description :global(ul),
  .product-description :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .product-description :global(li) {
    margin-bottom: 0.25rem;
  }
  .product-description :global(iframe),
  .product-description :global(video),
  .product-description :global(img) {
    max-width: 100%;
    height: auto;
  }
  .product-description :global(iframe) {
    aspect-ratio: 16/9;
    width: 100%;
  }
  .thumb-scroll-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .thumb-scroll-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script define:vars={{ partsReadMore: t.parts_read_more, partsReadLess: t.parts_read_less, partsAdded: t.parts_added }}>
  function setupProductPage() {
    // Image gallery
    const imgContainer = document.getElementById('img-container')
    const imgTrack = document.getElementById('img-track')
    const thumbs = document.querySelectorAll('.thumb-btn')
    const prevBtn = document.getElementById('img-prev')
    const nextBtn = document.getElementById('img-next')
    const thumbStrip = document.getElementById('thumb-strip')
    const totalImages = thumbs.length || 1
    let current = 0

    if (imgTrack && totalImages > 1) {
      let touchStartX = 0
      let touchStartY = 0
      let touchDeltaX = 0
      let isDragging = false
      let isHorizontal = null
      const containerWidth = () => (imgContainer ? imgContainer.offsetWidth : 0)

      function scrollThumbIntoView(index) {
        if (!thumbStrip) return
        const thumb = thumbs[index]
        if (!thumb) return
        const stripRect = thumbStrip.getBoundingClientRect()
        const thumbRect = thumb.getBoundingClientRect()
        if (thumbRect.left < stripRect.left) {
          thumbStrip.scrollBy({ left: thumbRect.left - stripRect.left - 8, behavior: 'smooth' })
        } else if (thumbRect.right > stripRect.right) {
          thumbStrip.scrollBy({ left: thumbRect.right - stripRect.right + 8, behavior: 'smooth' })
        }
      }

      function goTo(index, animate = true) {
        current = Math.max(0, Math.min(index, totalImages - 1))
        if (animate) imgTrack.style.transition = 'transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)'
        else imgTrack.style.transition = 'none'
        imgTrack.style.transform = `translateX(-${current * containerWidth()}px)`

        thumbs.forEach((t, i) => {
          if (i === current) {
            t.classList.add('border-gray-900')
            t.classList.remove('border-gray-200')
          } else {
            t.classList.remove('border-gray-900')
            t.classList.add('border-gray-200')
          }
        })
        scrollThumbIntoView(current)
      }

      thumbs.forEach(t => {
        t.addEventListener('click', () => {
          goTo(parseInt(t.dataset.index || '0', 10))
        })
      })

      prevBtn?.addEventListener('click', () => goTo(current - 1))
      nextBtn?.addEventListener('click', () => goTo(current + 1))

      // Touch swipe with drag + velocity
      let touchStartTime = 0
      let lastMoveX = 0
      let lastMoveTime = 0
      let velocity = 0

      imgContainer.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX
        touchStartY = e.touches[0].clientY
        touchDeltaX = 0
        isDragging = true
        isHorizontal = null
        velocity = 0
        touchStartTime = Date.now()
        lastMoveX = touchStartX
        lastMoveTime = touchStartTime
        imgTrack.style.transition = 'none'
      }, { passive: true })

      imgContainer.addEventListener('touchmove', (e) => {
        if (!isDragging) return
        const dx = e.touches[0].clientX - touchStartX
        const dy = e.touches[0].clientY - touchStartY

        if (isHorizontal === null && (Math.abs(dx) > 8 || Math.abs(dy) > 8)) {
          isHorizontal = Math.abs(dx) > Math.abs(dy)
        }

        if (!isHorizontal) return

        e.preventDefault()
        touchDeltaX = dx

        // Track velocity
        const now = Date.now()
        const dt = now - lastMoveTime
        if (dt > 0) {
          velocity = (e.touches[0].clientX - lastMoveX) / dt
        }
        lastMoveX = e.touches[0].clientX
        lastMoveTime = now

        // Resist at edges
        let offset = -current * containerWidth() + dx
        if (current === 0 && dx > 0) offset = dx * 0.3
        if (current === totalImages - 1 && dx < 0) offset = -current * containerWidth() + dx * 0.3

        imgTrack.style.transform = `translateX(${offset}px)`
      }, { passive: false })

      imgContainer.addEventListener('touchend', () => {
        if (!isDragging || !isHorizontal) { isDragging = false; return }
        isDragging = false

        const absDelta = Math.abs(touchDeltaX)
        const absVelocity = Math.abs(velocity)
        const isFlick = absVelocity > 0.3
        const isPastThreshold = absDelta > containerWidth() * 0.15

        if ((isFlick || isPastThreshold) && touchDeltaX < 0 && current < totalImages - 1) {
          goTo(current + 1)
        } else if ((isFlick || isPastThreshold) && touchDeltaX > 0 && current > 0) {
          goTo(current - 1)
        } else {
          goTo(current)
        }
      }, { passive: true })

      // Recalc on resize
      window.addEventListener('resize', () => goTo(current, false))
    }

    // Variant price switching
    const variantBtns = document.querySelectorAll('.variant-btn')
    variantBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        variantBtns.forEach(b => {
          b.classList.remove('border-gray-900', 'bg-gray-900', 'text-white')
          b.classList.add('border-gray-300')
        })
        btn.classList.add('border-gray-900', 'bg-gray-900', 'text-white')
        btn.classList.remove('border-gray-300')
      })
    })

    // Description toggle
    const descWrapper = document.getElementById('desc-wrapper')
    const descToggle = document.getElementById('desc-toggle')
    const descFade = document.getElementById('desc-fade')
    if (descWrapper && descToggle) {
      const contentHeight = descWrapper.scrollHeight
      if (contentHeight <= 300) {
        descWrapper.style.maxHeight = 'none'
        descToggle.style.display = 'none'
        if (descFade) descFade.style.display = 'none'
      } else {
        let expanded = false
        descToggle.addEventListener('click', () => {
          expanded = !expanded
          if (expanded) {
            descWrapper.style.maxHeight = descWrapper.scrollHeight + 'px'
            descToggle.textContent = partsReadLess
            if (descFade) descFade.style.display = 'none'
          } else {
            descWrapper.style.maxHeight = '300px'
            descToggle.textContent = partsReadMore
            if (descFade) descFade.style.display = ''
          }
        })
      }
    }

    // Quantity selector
    let qty = 1
    const qtyValue = document.getElementById('qty-value')
    const qtyDecrease = document.getElementById('qty-decrease')
    const qtyIncrease = document.getElementById('qty-increase')

    qtyDecrease?.addEventListener('click', () => {
      if (qty > 1) { qty--; if (qtyValue) qtyValue.textContent = String(qty) }
    })
    qtyIncrease?.addEventListener('click', () => {
      qty++; if (qtyValue) qtyValue.textContent = String(qty)
    })

    // Add to Cart
    const addBtn = document.getElementById('add-to-cart-btn')
    addBtn?.addEventListener('click', () => {
      if (addBtn.disabled) return
      const d = addBtn.dataset
      const original = addBtn.innerHTML

      // Show spinner
      addBtn.disabled = true
      addBtn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>'

      setTimeout(() => {
        // Dispatch add event with quantity
        for (let i = 0; i < qty; i++) {
          window.dispatchEvent(new CustomEvent('cart:add', {
            detail: {
              handle: d.handle,
              title: d.title,
              price: parseFloat(d.price || '0'),
              image: d.image,
              variantId: d.variantId,
            }
          }))
        }

        // Show checkmark
        addBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" d="M4.5 12.75l6 6 9-13.5"/></svg> ' + partsAdded
        setTimeout(() => {
          addBtn.innerHTML = original
          addBtn.disabled = false
          qty = 1
          if (qtyValue) qtyValue.textContent = '1'
        }, 1200)
      }, 600)
    })

    // Shipping modal
    const shippingBtn = document.getElementById('shipping-info-btn')
    const shippingModal = document.getElementById('shipping-modal')
    const shippingPanel = document.getElementById('shipping-modal-panel')
    const shippingClose = document.getElementById('shipping-modal-close')
    const shippingOverlay = document.getElementById('shipping-modal-overlay')
    let shippingOpen = false

    function openShippingModal() {
      if (shippingOpen) return
      shippingOpen = true
      shippingModal?.classList.remove('hidden')
      document.body.style.overflow = 'hidden'
      requestAnimationFrame(() => {
        shippingOverlay?.classList.remove('opacity-0')
        shippingOverlay?.classList.add('opacity-100')
        shippingPanel?.classList.remove('opacity-0', 'scale-95', 'translate-y-4')
        shippingPanel?.classList.add('opacity-100', 'scale-100', 'translate-y-0')
      })
    }
    function closeShippingModal() {
      if (!shippingOpen) return
      shippingOverlay?.classList.remove('opacity-100')
      shippingOverlay?.classList.add('opacity-0')
      shippingPanel?.classList.remove('opacity-100', 'scale-100', 'translate-y-0')
      shippingPanel?.classList.add('opacity-0', 'scale-95', 'translate-y-4')
      setTimeout(() => {
        shippingModal?.classList.add('hidden')
        document.body.style.overflow = ''
        shippingOpen = false
      }, 300)
    }

    shippingBtn?.addEventListener('click', openShippingModal)
    shippingClose?.addEventListener('click', closeShippingModal)
    shippingOverlay?.addEventListener('click', closeShippingModal)

    // Lightbox
    const lightbox = document.getElementById('lightbox')
    const lightboxOverlay = document.getElementById('lightbox-overlay')
    const lightboxContent = document.getElementById('lightbox-content')
    const lightboxImg = document.getElementById('lightbox-img')
    const lightboxClose = document.getElementById('lightbox-close')
    const lightboxPrev = document.getElementById('lightbox-prev')
    const lightboxNext = document.getElementById('lightbox-next')
    const lightboxPrevM = document.getElementById('lightbox-prev-m')
    const lightboxNextM = document.getElementById('lightbox-next-m')
    const lightboxCounter = document.getElementById('lightbox-counter')

    // Collect all full-size image URLs from the gallery
    const galleryImages = []
    const mainSlides = imgTrack?.querySelectorAll('img') || []
    mainSlides.forEach(img => {
      galleryImages.push({ url: img.src, alt: img.alt })
    })
    if (galleryImages.length === 0) {
      const singleImg = document.getElementById('main-product-image')
      if (singleImg) galleryImages.push({ url: singleImg.src, alt: singleImg.alt })
    }

    let lightboxIndex = 0
    let lightboxOpen = false

    function updateLightbox() {
      if (!lightboxImg || galleryImages.length === 0) return
      lightboxImg.style.opacity = '0'
      setTimeout(() => {
        lightboxImg.src = galleryImages[lightboxIndex].url
        lightboxImg.alt = galleryImages[lightboxIndex].alt
        lightboxImg.onload = () => { lightboxImg.style.opacity = '1' }
        if (lightboxImg.complete) lightboxImg.style.opacity = '1'
      }, 150)
      if (lightboxCounter) lightboxCounter.textContent = `${lightboxIndex + 1} / ${galleryImages.length}`
    }

    function openLightbox(index) {
      if (lightboxOpen || !lightbox) return
      lightboxOpen = true
      lightboxIndex = index
      lightbox.classList.remove('hidden')
      document.body.style.overflow = 'hidden'
      if (lightboxImg) {
        lightboxImg.style.opacity = '0'
        lightboxImg.src = galleryImages[lightboxIndex].url
        lightboxImg.alt = galleryImages[lightboxIndex].alt
        lightboxImg.onload = () => { lightboxImg.style.opacity = '1' }
        if (lightboxImg.complete) lightboxImg.style.opacity = '1'
      }
      if (lightboxCounter) lightboxCounter.textContent = `${lightboxIndex + 1} / ${galleryImages.length}`
      requestAnimationFrame(() => {
        lightboxOverlay?.classList.remove('opacity-0')
        lightboxOverlay?.classList.add('opacity-100')
        lightboxContent?.classList.remove('opacity-0', 'scale-95')
        lightboxContent?.classList.add('opacity-100', 'scale-100')
      })
    }

    function closeLightbox() {
      if (!lightboxOpen || !lightbox) return
      lightboxOverlay?.classList.remove('opacity-100')
      lightboxOverlay?.classList.add('opacity-0')
      lightboxContent?.classList.remove('opacity-100', 'scale-100')
      lightboxContent?.classList.add('opacity-0', 'scale-95')
      setTimeout(() => {
        lightbox.classList.add('hidden')
        document.body.style.overflow = ''
        lightboxOpen = false
      }, 300)
    }

    function lightboxGoPrev() {
      lightboxIndex = (lightboxIndex - 1 + galleryImages.length) % galleryImages.length
      updateLightbox()
    }
    function lightboxGoNext() {
      lightboxIndex = (lightboxIndex + 1) % galleryImages.length
      updateLightbox()
    }

    // Click main image area to open lightbox
    imgContainer?.addEventListener('click', (e) => {
      const target = e.target
      if (target.closest('#img-prev') || target.closest('#img-next')) return
      openLightbox(totalImages > 1 ? current : 0)
    })

    lightboxClose?.addEventListener('click', closeLightbox)
    lightboxOverlay?.addEventListener('click', closeLightbox)
    lightboxPrev?.addEventListener('click', lightboxGoPrev)
    lightboxNext?.addEventListener('click', lightboxGoNext)
    lightboxPrevM?.addEventListener('click', lightboxGoPrev)
    lightboxNextM?.addEventListener('click', lightboxGoNext)

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && shippingOpen) closeShippingModal()
      if (!lightboxOpen) return
      if (e.key === 'Escape') closeLightbox()
      if (e.key === 'ArrowLeft') lightboxGoPrev()
      if (e.key === 'ArrowRight') lightboxGoNext()
    })
  }

  setupProductPage()
  document.addEventListener('astro:after-swap', setupProductPage)
</script>
