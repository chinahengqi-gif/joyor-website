---
import Base from '../../layouts/Base.astro'
import PartCard from '../../components/PartCard.astro'
import { getTranslations, LANG } from '../../i18n/index.js'
import { getCollectionProducts, getCategories, getModels } from '../../lib/shopify.js'

const t = getTranslations(LANG)
const products = await getCollectionProducts()
const categories = await getCategories(products)
const models = await getModels(products)
---

<Base title={t.all_parts} description={t.hero_subtitle} bgColor="#eeeff2">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-10 pt-28 pb-20">
    <!-- Header with Title & Filter -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <h1 class="text-4xl lg:text-5xl font-medium tracking-tight text-gray-900 line-height-1">{t.all_parts}</h1>
      </div>

      <div class="grid grid-cols-2 md:flex md:flex-wrap items-center gap-3 md:gap-4 w-full md:w-auto">
        <!-- Model Dropdown -->
        <div class="relative filter-dropdown" data-type="model">
          <button class="w-full flex items-center justify-between md:justify-start gap-3 px-5 py-2 bg-transparent border border-black rounded-full hover:bg-black/5 transition-all group text-left">
            <div class="flex items-center gap-2 overflow-hidden">
              <span class="text-[11px] md:text-[13px] font-bold uppercase tracking-wider text-black shrink-0">Model:</span>
              <span class="filter-label text-[11px] md:text-[13px] font-medium text-black truncate">{t.filter_all}</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-black group-hover:translate-y-0.5 transition-transform shrink-0"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="dropdown-panel absolute left-0 md:right-0 md:left-auto mt-4 w-[calc(100vw-3rem)] md:w-80 bg-white rounded-2xl shadow-2xl border border-gray-100 p-6 z-50 opacity-0 translate-y-2 pointer-events-none transition-all duration-300 ease-out">
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-gray-400 mb-4">{t.filter_by_model}</p>
            <div class="flex flex-wrap gap-2 mb-6">
              <button class="filter-option px-4 py-2 border border-black text-xs font-semibold text-gray-900 rounded-lg transition-all active" data-value="">{t.filter_all}</button>
              {models.map(m => (
                <button class="filter-option px-4 py-2 border border-black text-xs font-semibold text-gray-900 rounded-lg transition-all hover:bg-gray-50 uppercase" data-value={m}>{m}</button>
              ))}
            </div>
            <button class="filter-clear-btn w-full py-3 border border-gray-200 rounded-lg text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-black hover:border-black transition-all">
              Clear Model
            </button>
          </div>
        </div>

        <!-- Category Dropdown -->
        <div class="relative filter-dropdown" data-type="category">
          <button class="w-full flex items-center justify-between md:justify-start gap-3 px-5 py-2 bg-transparent border border-black rounded-full hover:bg-black/5 transition-all group text-left">
            <div class="flex items-center gap-2 overflow-hidden">
              <span class="text-[11px] md:text-[13px] font-bold uppercase tracking-wider text-black shrink-0">Category:</span>
              <span class="filter-label text-[11px] md:text-[13px] font-medium text-black truncate">{t.filter_all}</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-black group-hover:translate-y-0.5 transition-transform shrink-0"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="dropdown-panel absolute right-0 mt-4 w-[calc(100vw-3rem)] md:w-80 bg-white rounded-2xl shadow-2xl border border-gray-100 p-6 z-50 opacity-0 translate-y-2 pointer-events-none transition-all duration-300 ease-out">
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-gray-400 mb-4">{t.filter_by_category}</p>
            <div class="flex flex-wrap gap-2 mb-6">
              <button class="filter-option px-4 py-2 border border-black text-xs font-semibold text-gray-900 rounded-lg transition-all active" data-value="">{t.filter_all}</button>
              {categories.map(cat => (
                <button class="filter-option px-4 py-2 border border-black text-xs font-semibold text-gray-900 rounded-lg transition-all hover:bg-gray-50 uppercase" data-value={cat}>{cat}</button>
              ))}
            </div>
            <button class="filter-clear-btn w-full py-3 border border-gray-200 rounded-lg text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-black hover:border-black transition-all">
              Clear Category
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Product Grid Section -->
    <div class="mb-6">
      <p class="text-gray-400 uppercase tracking-widest text-[10px] font-bold" id="count-display">
        {products.length} {t.products_count.split(' ')[1] || 'Items'}
      </p>
    </div>

    <div 
      class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6" 
      id="products-grid"
    >
      {(products as any[]).map(product => (
        <div class="product-item" data-category={product.category} data-models={product.compatible.join(',')}>
          <PartCard product={product} />
        </div>
      ))}
    </div>

    <!-- No Results State -->
    <div id="no-results" class="hidden py-20 text-center">
      <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900">No parts found</h3>
      <p class="text-gray-500 mt-2">Try adjusting your filters to find what you're looking for.</p>
      <button class="mt-8 text-sm font-bold uppercase tracking-wider underline underline-offset-4 hover:text-gray-600 transition-colors" onclick="document.getElementById('clear-filters').click()">
        Clear all filters
      </button>
    </div>
  </div>
</Base>

<style>
  .filter-option.active {
    background: #000;
    color: #fff;
    font-weight: 600;
  }
  .filter-clear-btn.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }
  .filter-clear-btn.active:hover {
    background: #333;
    border-color: #333;
  }
</style>

<script>
  function setupPartsPage() {
    const dropdowns = document.querySelectorAll('.filter-dropdown');
    const items = document.querySelectorAll('.product-item');
    const countDisplay = document.getElementById('count-display');
    const noResults = document.getElementById('no-results');
    const grid = document.getElementById('products-grid');
    const clearBtn = document.getElementById('clear-filters');

    let activeFilters: Record<string, string> = {
      category: '',
      model: ''
    };

    const toggleDropdown = (dropdown: HTMLElement) => {
      const panel = dropdown.querySelector('.dropdown-panel');
      const isVisible = panel?.classList.contains('opacity-100');
      
      // Close all others
      document.querySelectorAll('.dropdown-panel').forEach(p => {
        p.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        p.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
      });
      
      if (!isVisible) {
        panel?.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        panel?.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
      }
    };

    const applyFilters = () => {
      let visibleCount = 0;
      items.forEach(item => {
        const cat = item.getAttribute('data-category');
        const mods = item.getAttribute('data-models')?.split(',') || [];
        
        const matchCat = !activeFilters.category || cat === activeFilters.category;
        const matchMod = !activeFilters.model || mods.includes(activeFilters.model);
        
        const isVisible = matchCat && matchMod;
        (item as HTMLElement).style.display = isVisible ? 'block' : 'none';
        if (isVisible) visibleCount++;
      });

      if (countDisplay) {
        countDisplay.textContent = `${visibleCount} Item${visibleCount === 1 ? '' : 's'}`;
      }

      const hasActive = activeFilters.category || activeFilters.model;
      if (clearBtn) {
        clearBtn.classList.toggle('hidden', !hasActive);
      }

      if (grid) {
        grid.style.display = visibleCount === 0 ? 'none' : 'grid';
      }
      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    const updateClearBtnState = (dropdown: HTMLElement, isActive: boolean) => {
      const clearBtn = dropdown.querySelector('.filter-clear-btn');
      if (clearBtn) {
        clearBtn.classList.toggle('active', isActive);
      }
    };

    dropdowns.forEach(dropdown => {
      const dropdownEl = dropdown as HTMLElement;
      const btn = dropdown.querySelector('button');
      const label = dropdown.querySelector('.filter-label');
      const options = dropdown.querySelectorAll('.filter-option');
      const clearPanelBtn = dropdown.querySelector('.filter-clear-btn');
      const type = dropdown.getAttribute('data-type');

      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown(dropdownEl);
      });

      options.forEach(opt => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const value = opt.getAttribute('data-value') || '';
          const text = (opt as HTMLElement).textContent || '';
          
          if (type) {
            activeFilters[type] = value;
            updateClearBtnState(dropdownEl, !!value);
          }
          if (label) label.textContent = text;

          // Update active state
          options.forEach(o => o.classList.remove('active'));
          opt.classList.add('active');

          // Close panel
          const panel = dropdown.querySelector('.dropdown-panel');
          panel?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          panel?.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
          
          applyFilters();
        });
      });

      clearPanelBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (type) {
          activeFilters[type] = '';
          updateClearBtnState(dropdownEl, false);
        }
        if (label) label.textContent = 'All';
        
        // Reset options
        options.forEach(o => o.classList.remove('active'));
        dropdown.querySelector('.filter-option[data-value=""]')?.classList.add('active');

        // Close panel
        const panel = dropdown.querySelector('.dropdown-panel');
        panel?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        panel?.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');

        applyFilters();
      });
    });

    // Close on click outside
    document.addEventListener('click', () => {
      document.querySelectorAll('.dropdown-panel').forEach(p => {
        p.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        p.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
      });
    });

    // Handle Add to Cart delegation
    grid?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.add-to-cart-btn');
      if (btn) {
        window.dispatchEvent(new CustomEvent('cart:open'));
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span class="text-[9px]">Added!</span>';
        setTimeout(() => {
          btn.innerHTML = originalText;
        }, 1500);
      }
    });
  }

  // Init
  setupPartsPage();
  document.addEventListener('astro:after-swap', setupPartsPage);
</script>
