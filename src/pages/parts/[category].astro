---
import Base from '../../layouts/Base.astro'
import PartCard from '../../components/PartCard.astro'
import { getTranslations, LANG } from '../../i18n/index.js'
import { getCollectionProducts, getCategories, getModels } from '../../lib/shopify.js'
import { slugify } from '../../lib/utils.js'

const t = getTranslations(LANG)

export async function getStaticPaths() {
  const { getCollectionProducts, getCategories } = await import('../../lib/shopify.js')
  const { slugify } = await import('../../lib/utils.js')
  const products = await getCollectionProducts()
  const categories = await getCategories(products)

  return categories.map(cat => ({
    params: { category: slugify(cat) },
    props: { categoryName: cat },
  }))
}

const { categoryName } = Astro.props
const allProducts = await getCollectionProducts()
const products = allProducts.filter(p => p.category === categoryName)
const models = await getModels(products)

// Other categories (for the bottom explorer)
const allCategories = await getCategories(allProducts)
const otherCategories = allCategories
  .filter(c => c !== categoryName)
  .slice(0, 8)
  .map(c => ({
    name: c,
    slug: slugify(c),
    count: allProducts.filter(p => p.category === c).length,
  }))
---

<Base
  title={t.parts_category_meta_title.replace('{category}', categoryName)}
  description={t.parts_category_meta_desc.replace('{category}', categoryName)}
  bgColor="#eeeff2"
>
  <div class="pt-28 pb-20">

    <!-- Breadcrumb -->
    <div class="max-w-[1440px] mx-auto px-6 lg:px-10 mb-4">
      <nav class="text-xs uppercase tracking-widest text-black/40">
        <a href="/parts/" class="hover:text-black transition-colors">{t.all_parts}</a>
        <span class="mx-2">/</span>
        <span class="text-black">{categoryName}</span>
      </nav>
    </div>

    <!-- Mobile Title (not sticky) -->
    <div class="lg:hidden max-w-[1440px] mx-auto px-6 mb-4">
      <h1 class="text-4xl font-medium tracking-tight font-['IBM_Plex_Sans',sans-serif]">{categoryName}</h1>
      <p class="text-sm text-black/50 mt-2">{t.common_items.replace('{count}', String(products.length))}</p>
    </div>

    <!-- Sticky Action Bar -->
    <div class="sticky top-12 lg:static z-30 mb-8 lg:mb-12" id="parts-action-bar">
      <div class="max-w-[1440px] mx-auto px-6 lg:px-10 py-3 flex flex-wrap lg:flex-nowrap items-center gap-3">
        <div class="hidden lg:block lg:mr-auto">
          <h1 class="text-4xl md:text-5xl font-medium tracking-tight font-['IBM_Plex_Sans',sans-serif]">{categoryName}</h1>
          <p class="text-sm text-black/50 mt-1">{t.common_items.replace('{count}', String(products.length))}</p>
        </div>
        <div class="w-full lg:w-auto grid grid-cols-1 lg:flex gap-3">

          <!-- Model Dropdown -->
          <div class="relative filter-dropdown" data-type="model">
            <button class="w-full flex items-center justify-center gap-2 px-5 py-1.5 bg-transparent border border-gray-400 rounded-full hover:border-black transition-all group">
              <span class="text-sm font-medium text-[#1e1e1e] truncate"><span class="filter-label">{t.filter_all}</span> <span class="opacity-50">/ {t.nav_models}</span></span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-black shrink-0"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="dropdown-panel fixed lg:absolute left-3 lg:left-auto right-3 lg:right-0 lg:w-80 bg-white rounded-2xl shadow-2xl border border-black/5 p-6 z-[60] opacity-0 translate-y-2 pointer-events-none transition-all duration-300 ease-out">
              <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-black/40 mb-4">{t.filter_by_model}</p>
              <div class="flex flex-wrap gap-2 mb-6">
                <button class="filter-option px-4 py-2 border border-black text-xs font-semibold text-black rounded-lg transition-all active" data-value="">{t.filter_all}</button>
                {models.map(m => (
                  <button class="filter-option px-4 py-2 border border-black text-xs font-semibold text-black rounded-lg transition-all hover:bg-black/5 uppercase" data-value={m}>{m}</button>
                ))}
              </div>
              <button class="filter-clear-btn w-full py-3 border border-black/10 rounded-lg text-[10px] font-bold uppercase tracking-widest text-black/40 hover:text-black hover:border-black transition-all">
                {t.parts_clear_model}
              </button>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="max-w-[1440px] mx-auto px-4 md:px-6 lg:px-10">

      <!-- Product Grid Section -->
      <div class="mb-6">
        <p class="text-gray-400 uppercase tracking-widest text-[10px] font-bold" id="count-display">
          {t.common_items.replace('{count}', String(products.length))}
        </p>
      </div>

      {products.length === 0 ? (
        <div class="py-20 text-center bg-white rounded-2xl">
          <p class="text-black/60">{t.parts_category_empty}</p>
          <a href="/parts/" class="inline-block mt-6 underline text-black">{t.parts_browse_all}</a>
        </div>
      ) : (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-0 md:gap-6" id="products-grid">
          {products.map(product => (
            <div
              class="product-card-wrapper border-b border-r border-gray-100 md:border-none"
              data-category={product.category}
              data-models={product.compatible.join(',')}
            >
              <PartCard product={product} />
            </div>
          ))}
        </div>
      )}

      <!-- No Results State -->
      <div id="no-results" class="hidden py-20 text-center">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <h3 class="text-lg font-medium text-black">{t.parts_empty}</h3>
        <p class="text-black/50 mt-2">{t.parts_try_model}</p>
      </div>

    </div>

    <!-- Other Categories -->
    {otherCategories.length > 0 && (
      <section class="max-w-[1440px] mx-auto px-6 lg:px-10 pt-20">
        <h2 class="text-2xl lg:text-3xl font-medium tracking-tight text-black mb-8">{t.parts_more_categories}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {otherCategories.map(c => (
            <a href={`/parts/${c.slug}/`} class="group block p-6 bg-white rounded-2xl transition-colors">
              <p class="text-base font-medium text-black mb-1">{c.name}</p>
              <p class="text-xs text-black/50">{t.common_items.replace('{count}', String(c.count))}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Bottom CTA -->
    <section class="mt-20">
      <div class="bg-black text-white py-16 lg:py-24">
        <div class="max-w-[1440px] mx-auto px-6 lg:px-10 text-center">
          <h2 class="text-3xl lg:text-5xl font-medium tracking-tight mb-4">{t.parts_help_title}</h2>
          <p class="text-white/70 mb-8 max-w-xl mx-auto">{t.parts_help_text}</p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a href="/parts/" class="px-6 py-3 bg-white text-black rounded-full text-sm font-medium hover:bg-white/90 transition-colors">{t.parts_all}</a>
            <a href="/service/" class="px-6 py-3 border border-white/40 text-white rounded-full text-sm font-medium hover:bg-white/10 transition-colors">{t.parts_help_cta}</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Base>

<style>
  .filter-option.active {
    background: #000;
    color: #fff;
    font-weight: 600;
  }
  .filter-clear-btn.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }
</style>

<script define:vars={{ partsAdded: t.parts_added }}>
  function setupCategoryStickyBar() {
    const bar = document.getElementById('parts-action-bar');
    if (!bar) return;
    const check = () => {
      const isMobile = window.matchMedia('(max-width: 1023px)').matches;
      if (!isMobile) {
        bar.style.backgroundColor = '';
        bar.style.backdropFilter = '';
        bar.style.boxShadow = '';
        return;
      }
      const stuck = bar.getBoundingClientRect().top <= 49;
      if (stuck) {
        bar.style.backgroundColor = 'rgba(255,255,255,0.95)';
        bar.style.backdropFilter = 'blur(20px)';
        bar.style.boxShadow = '0 1px 3px rgba(0,0,0,0.06)';
      } else {
        bar.style.backgroundColor = '';
        bar.style.backdropFilter = '';
        bar.style.boxShadow = '';
      }
    };
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('resize', check);
    check();
  }

  function setupCategoryPage() {
    setupCategoryStickyBar();
    const dropdowns = document.querySelectorAll('.filter-dropdown');
    const dropdownPanels = new Map<HTMLElement, HTMLElement>();
    const positionPanels = new Map<HTMLElement, HTMLElement>();

    dropdowns.forEach(d => {
      const dEl = d as HTMLElement;
      const panel = d.querySelector('.dropdown-panel') as HTMLElement | null;
      const btn = d.querySelector('button') as HTMLElement | null;
      if (panel && btn) {
        dropdownPanels.set(dEl, panel);
        positionPanels.set(panel, btn);
        if (panel.parentElement !== document.body) {
          document.body.appendChild(panel);
        }
      }
    });

    const positionPanel = (panel: HTMLElement) => {
      const btn = positionPanels.get(panel);
      if (!btn) return;
      const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
      const rect = btn.getBoundingClientRect();
      if (isDesktop) {
        panel.style.top = `${rect.bottom + 16}px`;
        panel.style.right = `${window.innerWidth - rect.right}px`;
        panel.style.left = 'auto';
      } else {
        panel.style.top = `112px`;
        panel.style.left = '12px';
        panel.style.right = '12px';
      }
    };

    const items = document.querySelectorAll('.product-card-wrapper');
    const countDisplay = document.getElementById('count-display');
    const noResults = document.getElementById('no-results');
    const grid = document.getElementById('products-grid');

    let activeFilters: Record<string, string> = { model: '' };

    const toggleDropdown = (dropdown: HTMLElement) => {
      const realPanel = dropdownPanels.get(dropdown);
      if (!realPanel) return;
      const isVisible = realPanel.classList.contains('opacity-100');
      dropdownPanels.forEach(p => {
        p.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        p.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
      });
      if (!isVisible) {
        positionPanel(realPanel);
        realPanel.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        realPanel.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
      }
    };

    const applyFilters = () => {
      let visibleCount = 0;
      items.forEach(item => {
        const mods = item.getAttribute('data-models')?.split(',') || [];
        const matchMod = !activeFilters.model || mods.includes(activeFilters.model);
        (item as HTMLElement).style.display = matchMod ? 'block' : 'none';
        if (matchMod) visibleCount++;
      });
      if (countDisplay) {
        countDisplay.textContent = `${visibleCount} Item${visibleCount === 1 ? '' : 's'}`;
      }
      if (grid) {
        grid.style.display = visibleCount === 0 ? 'none' : 'grid';
      }
      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    dropdowns.forEach(dropdown => {
      const dropdownEl = dropdown as HTMLElement;
      const btn = dropdown.querySelector('button');
      const label = dropdown.querySelector('.filter-label');
      const panel = dropdownPanels.get(dropdownEl);
      const options = panel?.querySelectorAll('.filter-option') || [] as any;
      const clearPanelBtn = panel?.querySelector('.filter-clear-btn');
      const type = dropdown.getAttribute('data-type');

      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown(dropdownEl);
      });

      options.forEach(opt => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const value = opt.getAttribute('data-value') || '';
          const text = (opt as HTMLElement).textContent || '';
          if (type) activeFilters[type] = value;
          if (label) label.textContent = text;
          options.forEach(o => o.classList.remove('active'));
          opt.classList.add('active');
          panel?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          panel?.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
          applyFilters();
        });
      });

      clearPanelBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (type) activeFilters[type] = '';
        if (label) label.textContent = 'All';
        options.forEach(o => o.classList.remove('active'));
        panel?.querySelector('.filter-option[data-value=""]')?.classList.add('active');
        panel?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        panel?.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
        applyFilters();
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      for (const p of dropdownPanels.values()) {
        if (p.contains(target)) return;
      }
      dropdownPanels.forEach(p => {
        p.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        p.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
      });
    });

    grid?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.add-to-cart-btn');
      if (btn) {
        window.dispatchEvent(new CustomEvent('cart:open'));
        const originalText = btn.innerHTML;
        btn.innerHTML = `<span class="text-[9px]">${partsAdded}</span>`;
        setTimeout(() => { btn.innerHTML = originalText; }, 1500);
      }
    });
  }

  setupCategoryPage();
  document.addEventListener('astro:after-swap', setupCategoryPage);
</script>
</content>
</invoke>
