---
import Base from '../layouts/Base.astro'
import { getTranslations, LANG } from '../i18n/index.js'

const t = getTranslations(LANG)
---

<Base title={t.about_title} description={t.about_text}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold mb-6">{t.about_title}</h1>
    <p class="text-lg text-gray-600 leading-relaxed">{t.about_text}</p>
  </div>
</Base>
